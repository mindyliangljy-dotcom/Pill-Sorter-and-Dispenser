{"mode":"Text","hardwareTarget":"brain","textContent":"void sortPill() {\n  motor1.resetPosition();\n  motor2.resetPosition();\n  ///CHANGE THESE LATER. Add direction depending on relation to initial storage container.\n  float greenDist = 0;\n  float redDist = 0;\n  float yellowDist = 0;\n  float motor2Deg =0;\n\n  bool greenDirect;\n  bool redDirect;\n  bool yellowDirect; \n\n  //Waits until button E pressed and released to start sorting\n  while(!Controller.ButtonEUp.pressing()){}\n  while(Controller.ButtonEUp.pressing()){}\n\n  String colour = colourSensingFuncName(Parameters);\n\n  //moves horizontal motor based on pill colour\n  if(colour == 'green'){\n    MotorMovement(greenDist , greenDirect, gearCirc, motor1);\n  }\n  else if(colour == 'red'){\n        MotorMovement(redDist , redDirect, gearCirc, motor1);\n  }\n  else if(colour == 'yellow'){\n        MotorMovement(yellowDist , yellowDirect, gearCirc, motor1);\n  }\n  else{\n    //Take out later\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.print(\"Colour detected not valid\");\n  }\n  //pushes pill\n  motor2.spin(forward, 50, percent);\n  while(motor2.position(degrees) < motor2Deg){}\n  motor2.stop(brake);\n  wait(2,seconds);\n\n  //resets both motors to og position\n  resetmotors(motor2, motor2.position(degrees)); //CHANGE TO CALL REAL FUNCTION\n  resetmotors(motor1, motor1.position(degrees));\n}\n\n","textLanguage":"cpp","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}