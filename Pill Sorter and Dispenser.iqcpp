{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n#include <cmath>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n#include <string>\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n//forward delcaaration of all functions\nvoid sortPill(int &redPill, int &bluePill, int &yellowPill);\nvoid dispense(int &redPill, int &bluePill, int &yellowPill);\nvoid MotorMovement (float distance, bool direction, float gearCirc, motor &targetMotor);\nvoid userInput(std::string &pillColor, int &numberOfPillsRequested);\nstd::string colourDetect(int &redPill, int &bluePill, int &yellowPill);\nvoid resetMotors(motor &targetMotor);\nvoid pillInventory(int &numberOfPills, int pillsAddedOrRemoved);\n\n\nint main() {\n  //colours still need to be finalized. mismatches in code.\n  vexcodeInit();\n  int redPill = 0, bluePill = 0, yellowPill = 0;\n  \n  sortPill(redPill, bluePill, yellowPill);//internally waits until button E is pressed\n  //stops sorting when one of the three colours isn't detected. should probably be changed (find what colour detector reads when empty and add that to\n  //sorter function)\n\n  //if we add a loop here the machine can forever be able to dispense.\n  dispense(redPill, bluePill, yellowPill); //Dispensing can't start until ALL pills sorted. Should this change? Probs not. \n  //waits until button F is pressed\n}\n\nvoid sortPill(int &redPill, int &bluePill, int &yellowPill) {\n  motor1.resetPosition();\n  motor2.resetPosition();\n  const float gearCirc1 = 0.0, gearCirc2 = 0.0;\n\n  ///Add direction depending on relation to initial storage container.\n  float greenDist = 0;//CHANGE\n  float redDist = 0;//CHANGE\n  float yellowDist = 0;//CHANGE\n  float motor2Deg =0;\n\n  bool greenDirect;\n  bool redDirect;\n  bool yellowDirect; \n\n  bool validPill = true;\n  //Waits until button E pressed and released to start sorting\n  while(!Controller.ButtonEUp.pressing()){}\n  while(Controller.ButtonEUp.pressing()){}\n  std::string colour = colourDetect(redPill, bluePill, yellowPill);\n  if(colour!= \"green\" && colour!=\"yellow\"&& colour !=\"red\"){\n    validPill=false;\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.print(\"Inalid colour detected\");\n  }\n  while(validPill){\n    //moves horizontal motor based on pill colour\n    if(colour== \"green\"){\n      MotorMovement(greenDist , greenDirect, gearCirc1, motor1);\n    }\n    else if(colour == \"red\"){\n          MotorMovement(redDist , redDirect, gearCirc1, motor1);\n    }\n    else if(colour == \"yellow\"){\n          MotorMovement(yellowDist , yellowDirect, gearCirc1, motor1);\n    }\n    //pushes pill\n    int VertDist; //CHANGE\n    MotorMovement(VertDist, 1 , gearCirc2, motor2); //moves motor up\n    MotorMovement(VertDist, 0 , gearCirc2, motor2);//moves it back down\n    wait(0.5,seconds);\n\n    //resets both motors to og position: Needs to be next to optical sensor\n    resetMotors(motor2); \n    resetMotors(motor1);\n    wait(1,seconds);\n    colour = colourDetect(redPill, bluePill, yellowPill);\n    if(colour!= \"green\" && colour!=\"yellow\"&& colour !=\"red\"){\n      validPill=false;\n      Brain.Screen.clearScreen();\n      Brain.Screen.setCursor(1,1);\n      Brain.Screen.print(\"Invalid colour detected\");\n    }\n  }\n\n  //shows that sorting is done\n  Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(1,1);\n  Brain.Screen.print(\"Sorting finished\");\n}\n\nvoid dispense(int &redPill, int &bluePill, int &yellowPill) {\n\n\n  //Button on controller to manually start the dispensing\n  //TouchLED + joystick function to determine type + number of pills\n  //Horizontal motor moves shaft based on type of pill\n  //Vertical motor moves so that angled piece is pushed up and 1 pill falls out\n  //Repeats based on number of pills entered\n  //System automatically shuts down after finishing dispensing pills\n\n  //Note: FUp Button will be the one to start the dispensing as well as confirm the pill color\n  const float gearCirc3 = 0.0, gearCirc4 = 0.0; //CHANGE\n\n  while(!Controller.ButtonFUp.pressing())\n  {}\n  while(Controller.ButtonFUp.pressing())\n  {}\n  Brain.Screen.print (\"Choose type and number of pills using joystick and Touch LED\");\n  std::string pillColor{};\n  int numberOfPills = 0;\n  float motor3Distance = 0.0, motor4Distance = 0.0;\n  bool enoughPills =0;\n  userInput(pillColor, numberOfPills); // Sets Pill Colour and Number of pills by reference\n  if (pillColor == \"red\")\n  {\n    motor3Distance = 0; //distance to red container//CHANGE;\n    pillInventory(redPill, -numberOfPills);\n    if(redPill >=0){\n      enoughPills =1;\n    }\n  }\n  else if(pillColor == \"blue\")\n  {\n    motor3Distance = 0;//distance to blue container//CHANGE;\n    pillInventory (bluePill, -numberOfPills);\n    if(bluePill >=0){\n      enoughPills =1;\n    }\n  }\n  else\n  {\n    motor3Distance = 0; //distance to yellow container//CHANGE;\n    pillInventory(yellowPill, -numberOfPills);\n    if(yellowPill >=0){\n      enoughPills =1;\n    }\n  }\n\n  if(enoughPills)//edited so it will dispense pills if there's enough of the requested colour even if another colour is empty\n  {\n    MotorMovement (motor3Distance, true, gearCirc3, motor3);\n    for (int i = 0; i < numberOfPills; i++)\n    {\n    MotorMovement (motor4Distance, true, gearCirc4, motor4);\n    resetMotors(motor4);\n    }\n  }\n  else\n  {\n    Brain.Screen.print(\"Not enough pills\");\n  }\n  resetMotors(motor3);\n  resetMotors(motor4);\n  Brain.programStop();\n}\n\n//we might want to make motor speed a parameter for this fucntion so we can select it individually\nvoid MotorMovement (float distance, bool direction, float gearCirc, motor &targetMotor)\n  // true = right/up, and false = left/down//\n  //1 turn = 360 degrees = gear circumference//\n  // motor1 = sorter horizontal, motor2 = sorter vertical, motor3 = dispenser horizontal, motor4 = dispenser vertical\n  {\n  float targetDegrees = 0.0;\n  targetDegrees = distance * (360/gearCirc);\n  targetMotor.resetPosition();\n  if(direction)\n  {\n    targetMotor.spin(forward, 50, percent);\n  }\n  else\n  {\n    targetMotor.spin(reverse, 50, percent);\n  }\n  while(abs(targetMotor.position(degrees)) < targetDegrees)\n  {}\n  targetMotor.stop(brake);\n}\n\nvoid userInput(std::string &pillColor, int &numberOfPillsRequested)\n{\n  bool confirm1Color = false, confirm2Color = false, confirm3Color = false, confirmPillNumber = false;\n  while(!confirm1Color && !confirm2Color && !confirm3Color)\n  {\n    while(!Controller.ButtonFUp.pressing() && Controller.AxisB.position() < 90)\n    {\n      TouchLED9.on(red);\n    }\n    while(Controller.ButtonFUp.pressing())\n    {\n      confirm1Color = true;\n      pillColor = \"red\";\n    }\n\n    while(Controller.AxisB.position() > 90)\n    {}\n    if(!confirm1Color)\n    {\n      while(!Controller.ButtonFUp.pressing() && Controller.AxisB.position() < 90)\n      {\n        TouchLED9.on(blue);\n      }\n      while(Controller.ButtonFUp.pressing())\n      {\n        confirm2Color = true;\n        pillColor = \"blue\";\n      }\n    }\n    while(Controller.AxisB.position() > 90)\n    {}\n    if(!confirm1Color && !confirm2Color)\n    {\n      while(!Controller.ButtonFUp.pressing() && Controller.AxisB.position() < 90)\n      {\n        TouchLED9.on(yellow);\n      }\n      while(Controller.ButtonFUp.pressing())\n      {\n        confirm3Color = true;\n        pillColor = \"yellow\";\n      }\n    }\n    while(Controller.AxisB.position() > 90)\n    {}\n  }\n  \n  while(!confirmPillNumber)\n  {\n    timer1.clear();\n    while(!TouchLED9.pressing() && !confirmPillNumber)\n    {\n      if (timer1.time(seconds) > 5)\n      {\n        confirmPillNumber = true;\n      }\n    }\n    while(TouchLED9.pressing())\n    {}\n    if(!confirmPillNumber)\n    {\n      numberOfPillsRequested++;\n    }\n  }\n\n}\n\nvoid pillInventory (int &numberOfPills, int pillsAddedOrRemoved)\n{\n  int currentNumPills = numberOfPills;\n  numberOfPills = currentNumPills + pillsAddedOrRemoved;\n}\n\nstd::string colourDetect(int &redPill, int &bluePill, int &yellowPill)\n{\n  std::string sensedColour =\"\";\n  if(Optical3.color() == red)\n  {\n    sensedColour=\"red\";\n    redPill ++;\n  }\n  else if(Optical3.color() == blue)\n  {\n    sensedColour=\"blue\";\n    bluePill ++;\n  }\n  else if(Optical3.color()==yellow)\n  {\n    sensedColour=\"yellow\";\n    yellowPill ++;\n  }\n  return sensedColour;\n\n}\n\nvoid resetMotors(motor &targetMotor)\n{\n\tint curAngl = (targetMotor.position(degrees) * -1) - 5;\n\ttargetMotor.resetPosition();\n\t\n\ttargetMotor.spin(reverse, 50, percent);\n\twhile(targetMotor.position(degrees) > curAngl) \n\t{\n\t\twait(10, msec);\n\t}\n\ttargetMotor.stop();\n}\n\n\n","textLanguage":"cpp","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}