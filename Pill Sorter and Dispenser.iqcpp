{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n  // Begin project code\n  //Sorter code\n\n  //Button on controller to manually start the dispensing\n  //TouchLED + joystick function to determine type + number of pills\n  //Horizontal motor moves shaft based on type of pill\n  //Vertical motor moves so that angled piece is pushed up and 1 pill falls out\n  //Repeats based on number of pills entered\n  //System automatically shuts down after finishing dispensing pills\n\n  while(!Controller.ButtonFUp.pressing())\n  {}\n  while(Controller.ButtonFUp.pressing())\n  {}\n  Brain.Screen.print (\"Choose type and number of pills using joystick and Touch LED\");\n  string pillColor{};\n  int numberOfPills = 0;\n  float motor3Distance = 0.0, motor4Distance = 0.0;\n  JoystickAndTouchLED(pillColor, numberOfPills);\n  if (pillColor == \"red\")\n  {\n    motor3Distance = //distance to red container//;\n    redPills = redPills - numberOfPills;\n  }\n  else if(pillColor == \"blue\")\n  {\n    motor3Distance = //distance to blue container//;\n    bluePills = bluePills - numberOfPills;\n  }\n  else\n  {\n    motor3Distance = //distance to yellow container//;\n    yellowPills = yellowPills - numberOfPills;\n  }\n  motorMovement (motor3Distance, true,);\n  if(redPills >= 0 && bluePills >= 0 && yellowPills>= 0)\n  {\n    for (int i = 0; i < numberOfPills; i++)\n    {\n    motorMovement (motor4Distance, true);\n    }\n  }\n  else\n  {\n    Brain.Screent.print(\"Not enough pills\")\n  }\n  resetEverything;\n  Brain.programStop();\n  return EXIT_SUCCESS;\n}\n","textLanguage":"cpp","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}