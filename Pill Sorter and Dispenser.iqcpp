{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\nconst float gearCirc1 = 0.0, gearCirc3 = 0.0, gearCirc4 = 0.0; //change it when you find the circumference\n//Assuming that the circumference of each gear is different\n\nvoid MotorMovement (float distance, bool direction, float gearCirc, string motorName)\n// true = right/up, and false = left/down//\n//1 turn = 360 degrees = gear circumference//\n// motor1 = sorter horizontal, motor2 = sweeper sorter, motor3 = dispenser horizontal, motor4 = dispenser vertical\n{\n  float degrees = 0.0;\n  degrees = distance * (360/gearCirc);\n  if (motorName == \"motor1\")\n  {\n    motor1.resetPosition();\n    if(direction)\n    {\n      motor1.spin(forward, 50, percent);\n    }\n    else\n    {\n      motor1.spin(reverse, 50, percent);\n    }\n    while(motor1.position(degrees) < degrees)\n    {}\n    motor1.stop(brake);\n  }\n  if (motorName == \"motor3\")\n  {\n    motor3.resetPosition();\n    if(direction)\n    {\n      motor3.spin(forward, 50, percent);\n    }\n    else\n    {\n      motor3.spin(reverse, 50, percent);\n    }\n    while(motor2.position(degrees) < degrees)\n    {}\n    motor3.stop(brake);\n  }\n  if (motorName == \"motor4\")\n  {\n    motor4.resetPosition();\n    if(direction)\n    {\n      motor4.spin(forward, 50, percent);\n    }\n    else\n    {\n      motor4.spin(reverse, 50, percent);\n    }\n    while(motor4.position(degrees) < degrees)\n    {}\n    motor4.stop(brake);\n  }\n}\n\nvoid JoystickAndTouchLED (string &pillColor, int &numberOfPills)\n{\n  bool confirm1Color = false, confirm2Color = false, confirm3Color = false, confirmPillNumber = false;\n  while(!confirm1Color && !confirm2Color && !confirm3Color)\n  {\n    while(!Controller.ButtonFUp.pressing() || Controller.AxisB.position() < 90)\n    {\n      TouchLED9.on(red);\n    }\n    while(Controller.ButtonFUp.pressing())\n    {\n      confirm1Color = true;\n      pillColor = \"red\";\n    }\n    while(Controller.AxisB.position() > 90)\n    {}\n    if(!confirm1Color)\n    {\n      while(!Controller.ButtonFUp.pressing() || Controller.AxisB.position() < 90)\n      {\n        TouchLED9.on(blue);\n      }\n      while(Controller.ButtonFUp.pressing())\n      {\n        confirm2Color = true;\n        pillColor = \"blue\";\n      }\n    }\n    while(Controller.AxisB.position() > 90)\n    {}\n    if(!confirm1Color && !confirm2Color)\n    {\n      while(!Controller.ButtonFUp.pressing() || Controller.AxisB.position() < 90)\n      {\n        TouchLED9.on(yellow);\n      }\n      while(Controller.ButtonFUp.pressing())\n      {\n        confirm3Color = true;\n        pillColor = \"yellow\";\n      }\n    }\n    while(Controller.AxisB.position() > 90)\n    {}\n  }\n  \n  while(!confirmPillNumber)\n  {\n    timer1.clear();\n    while(!TouchLED9.pressing() && !confirmPillNumber)\n    {\n      if (timer1.time(seconds) > 5)\n      {\n        confirmPillNumber = true;\n      }\n    }\n    while(TouchLED9.pressing())\n    {}\n    if(!confirmPillNumber)\n    {\n      numberOfPills++;\n    }\n  }\n\n}\n\nint pillInventory (int numberOfPills, int pillsAddedOrRemoved)\n{\n  int updatedPills = 0;\n  updatedPills = numberOfPills + pillsAddedOrRemoved;\n  return updatedPills;\n}\n\nint main() {\n  // Initializing Robot Configuration. DO NOT REMOVE!\n  vexcodeInit();\n  // Begin project code\n  int redPill = 0, bluePill = 0, yellowPill = 0;\n  \n}\n","textLanguage":"cpp","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}