{"mode":"Text","hardwareTarget":"brain","textContent":"#pragma region VEXcode Generated Robot Configuration\n// Make sure all required headers are included.\n#include <stdio.h>\n#include <stdlib.h>\n#include <stdbool.h>\n#include <math.h>\n#include <string.h>\n\n\n#include \"vex.h\"\n\nusing namespace vex;\n\n// Brain should be defined by default\nbrain Brain;\n\n\n// START IQ MACROS\n#define waitUntil(condition)                                                   \\\n  do {                                                                         \\\n    wait(5, msec);                                                             \\\n  } while (!(condition))\n\n#define repeat(iterations)                                                     \\\n  for (int iterator = 0; iterator < iterations; iterator++)\n// END IQ MACROS\n\n\n// Robot configuration code.\ninertial BrainInertial = inertial();\nmotor Motor1 = motor(PORT1, false);\nmotor Motor9 = motor(PORT9, false);\nmotor Motor3 = motor(PORT3, false);\nmotor Motor7 = motor(PORT7, true);\noptical Optical2 = optical(PORT2);\ncontroller Controller = controller();\ntouchled TouchLED10 = touchled(PORT10);\ntimer timer1;\n\n\n// generating and setting random seed\nvoid initializeRandomSeed(){\n  wait(100,msec);\n  double xAxis = BrainInertial.acceleration(xaxis) * 1000;\n  double yAxis = BrainInertial.acceleration(yaxis) * 1000;\n  double zAxis = BrainInertial.acceleration(zaxis) * 1000;\n  // Combine these values into a single integer\n  int seed = int(\n    xAxis + yAxis + zAxis\n  );\n  // Set the seed\n  srand(seed); \n}\n\n// Converts a color to a string\nconst char* convertColorToString(color col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\n// Convert colorType to string\nconst char* convertColorToString(colorType col) {\n  if (col == colorType::red) return \"red\";\n  else if (col == colorType::green) return \"green\";\n  else if (col == colorType::blue) return \"blue\";\n  else if (col == colorType::white) return \"white\";\n  else if (col == colorType::yellow) return \"yellow\";\n  else if (col == colorType::orange) return \"orange\";\n  else if (col == colorType::purple) return \"purple\";\n  else if (col == colorType::cyan) return \"cyan\";\n  else if (col == colorType::black) return \"black\";\n  else if (col == colorType::transparent) return \"transparent\";\n  else if (col == colorType::red_violet) return \"red_violet\";\n  else if (col == colorType::violet) return \"violet\";\n  else if (col == colorType::blue_violet) return \"blue_violet\";\n  else if (col == colorType::blue_green) return \"blue_green\";\n  else if (col == colorType::yellow_green) return \"yellow_green\";\n  else if (col == colorType::yellow_orange) return \"yellow_orange\";\n  else if (col == colorType::red_orange) return \"red_orange\";\n  else if (col == colorType::none) return \"none\";\n  else return \"unknown\";\n}\n\n\nvoid vexcodeInit() {\n\n  // Initializing random seed.\n  initializeRandomSeed(); \n}\n\n\n// define variable for remote controller enable/disable\nbool RemoteControlCodeEnabled = true;\n\n#pragma endregion VEXcode Generated Robot Configuration\n\n//----------------------------------------------------------------------------\n//                                                                            \n//    Module:       main.cpp                                                  \n//    Author:       {author}                                                  \n//    Created:      {date}                                                    \n//    Description:  IQ project                                                \n//                                                                            \n//----------------------------------------------------------------------------\n\n// Include the IQ Library\n#include \"iq_cpp.h\"\n#include <string>\n\n// Allows for easier use of the VEX Library\nusing namespace vex;\n\n//forward delcaaration of all functions\nvoid sortPill(int &greenPill, int &bluePill, int &redPill);\nvoid dispense(int &greenPill, int &bluePill, int &redPill);\nvoid MotorMovementHorizontal (float distance, motor &targetMotor);\nvoid MotorMovementVertical (float pauseup, motor &targetMotor);\nvoid userInput(std::string &pillColor, int &numberOfPillsRequested);\nstd::string colourDetect(int &greenPill, int &bluePill, int &redPill);\nvoid resetMotors(motor &targetMotor);\nvoid pillInventory(int &numberOfPills, int pillsAddedOrRemoved);\n\ncolor hueToColor(double hueValue)\n{\n  if(hueValue > 330 || hueValue <= 30)\n  {\n    return red;\n  }\n  else if(hueValue <= 60)\n  {\n    return orange;\n  }\n  else if(hueValue <= 150)\n  {  \n    return green;\n  }\n  else if(hueValue <= 330)\n  {\n    return blue;\n  }\n  return black;\n}\n\nint main() \n{\n  //colours still need to be finalized. mismatches in code.\n  vexcodeInit();\n  int greenPill = 0, bluePill = 0, redPill = 0;\n  Brain.Screen.setCursor(1,1);\n  sortPill(greenPill, bluePill, redPill);//internally waits until button E is pressed\n  //stops sorting when one of the three colours isn't detected. should probably be changed (find what colour detector reads when empty and add that to\n  //sorter function)\n\n  //if we add a loop here the machine can forever be able to dispense.\n  dispense(greenPill, bluePill, redPill); //Dispensing can't start until ALL pills sorted. Should this change? Probs not. \n  //waits until button F is pressed\n}\n\nvoid sortPill(int &greenPill, int &bluePill, int &redPill) {\n  Motor3.resetPosition();\n  Motor7.resetPosition();\n\n  ///Add direction depending on relation to initial storage container.\n  float greenDist = 0.0;\n  float blueDist = 60;\n  float redDist = 120;\n\n  bool validPill = true;\n  //Waits until button E pressed and released to start sorting\n  while(!Controller.ButtonEUp.pressing()){}\n  while(Controller.ButtonEUp.pressing()){}\n  wait(2,seconds);\n  std::string colour = colourDetect(greenPill, bluePill, redPill);\n  if(colour!= \"green\" && colour!=\"blue\"&& colour !=\"red\")\n  {\n    validPill=false;\n    Brain.Screen.clearScreen();\n    Brain.Screen.setCursor(1,1);\n    Brain.Screen.print(\"Invalid colour detected\");\n  }\n  while(validPill)\n  {\n    if(colour == \"green\")\n    {\n      Brain.Screen.print(\"green\");\n    }\n    \n    //moves horizontal motor based on pill colour\n    else if(colour == \"blue\"){\n          MotorMovementHorizontal(blueDist, Motor3);\n    }\n    else if(colour == \"red\"){\n          MotorMovementHorizontal(redDist, Motor3);\n    }\n    //pushes pill\n    MotorMovementVertical(0.275, Motor7); //moves motor up\n    wait(0.5,seconds);\n\n    //resets both motors to og position: Needs to be next to optical sensor\n    resetMotors(Motor3);\n    wait(1,seconds);\n    colour = colourDetect(greenPill, bluePill, redPill);\n    if(colour!= \"green\" && colour!=\"blue\"&& colour !=\"red\")\n    {\n      validPill=false;\n      /*Brain.Screen.clearScreen();\n      Brain.Screen.setCursor(1,1);\n      Brain.Screen.print(\"Invalid colour detected\");*/\n    }\n  }\n\n  //shows that sorting is done\n  //Brain.Screen.clearScreen();\n  Brain.Screen.setCursor(5,1);\n  Brain.Screen.print(\"Done\");\n}\n\nvoid dispense(int &greenPill, int &bluePill, int &redPill) {\n\n\n  //Button on controller to manually start the dispensing\n  //TouchLED + joystick function to determine type + number of pills\n  //Horizontal motor moves shaft based on type of pill\n  //Vertical motor moves so that angled piece is pushed up and 1 pill falls out\n  //Repeats based on number of pills entered\n  //System automatically shuts down after finishing dispensing pills\n\n  //Note: FUp Button will be the one to start the dispensing as well as confirm the pill color\n\n  while(!Controller.ButtonFUp.pressing())\n  {}\n  while(Controller.ButtonFUp.pressing())\n  {}\n  Brain.Screen.print (\"Choose type and number of pills using joystick and Touch LED\");\n  std::string pillColor{};\n  int numberOfPills = 0;\n  float motor1Distance = 0.0;\n  bool enoughPills =false;\n  userInput(pillColor, numberOfPills); // Sets Pill Colour and Number of pills by reference\n  if (pillColor == \"green\")\n  {\n    pillInventory(greenPill, -numberOfPills);\n    if(greenPill >=0){\n      enoughPills =true;\n    }\n  }\n  else if(pillColor == \"blue\")\n  {\n    motor1Distance = 85;\n    pillInventory (bluePill, -numberOfPills);\n    if(bluePill >=0){\n      enoughPills =true;\n    }\n  }\n  else\n  {\n    motor1Distance = 135;\n    pillInventory(redPill, -numberOfPills);\n    if(redPill >=0){\n      enoughPills =true;\n    }\n  }\n\n  if(enoughPills)//edited so it will dispense pills if there's enough of the requested colour even if another colour is empty\n  {\n    MotorMovementHorizontal(motor1Distance, Motor1);\n    for (int i = 0; i < numberOfPills; i++)\n    {\n    MotorMovementVertical(0.23, Motor9);\n    Motor9.spin(reverse, 50, percent);\n    while(Motor9.position(degrees) > -0.5)\n    {}\n    Motor9.stop(brake);\n    resetMotors(Motor1);\n    }\n  }\n  else\n  {\n    Brain.Screen.print(\"Not enough pills\");\n  }\n  Brain.programStop();\n}\n\n//we might want to make motor speed a parameter for this fucntion so we can select it individually\nvoid MotorMovementHorizontal (float targetDegrees, motor &targetMotor)\n{\n  targetMotor.resetPosition();\n  targetMotor.spin(forward, 94, percent);\n  while(targetMotor.position(degrees) < targetDegrees)\n  {}\n  targetMotor.stop(brake);\n}\n\nvoid MotorMovementVertical(float pauseup, motor &targetMotor)\n{\n    targetMotor.resetPosition();\n    targetMotor.spin(reverse, 85, percent);\n    wait(pauseup,seconds);\n    targetMotor.stop(brake);\n    wait(0.1, seconds);\n    while(targetMotor.position(degrees) < 0)\n    {\n      double diff = abs(targetMotor.position(degrees));\n      targetMotor.spin(forward, 100*diff/71, percent);\n    }\n    targetMotor.stop(brake);\n\n}\n\nvoid userInput(std::string &pillColor, int &numberOfPillsRequested)\n{\n  bool confirm1Color = false, confirm2Color = false, confirm3Color = false, confirmPillNumber = false;\n  while(!confirm1Color && !confirm2Color && !confirm3Color)\n  {\n    while(!Controller.ButtonFUp.pressing() && Controller.AxisB.position() < 90)\n    {\n      TouchLED10.on(green);\n    }\n    while(Controller.ButtonFUp.pressing())\n    {\n      confirm1Color = true;\n      pillColor = \"green\";\n    }\n\n    while(Controller.AxisB.position() > 90)\n    {}\n    if(!confirm1Color)\n    {\n      while(!Controller.ButtonFUp.pressing() && Controller.AxisB.position() < 90)\n      {\n        TouchLED10.on(blue);\n      }\n      while(Controller.ButtonFUp.pressing())\n      {\n        confirm2Color = true;\n        pillColor = \"blue\";\n      }\n    }\n    while(Controller.AxisB.position() > 90)\n    {}\n    if(!confirm1Color && !confirm2Color)\n    {\n      while(!Controller.ButtonFUp.pressing() && Controller.AxisB.position() < 90)\n      {\n        TouchLED10.on(red);\n      }\n      while(Controller.ButtonFUp.pressing())\n      {\n        confirm3Color = true;\n        pillColor = \"red\";\n      }\n    }\n    while(Controller.AxisB.position() > 90)\n    {}\n  }\n  \n  while(!confirmPillNumber)\n  {\n    timer1.clear();\n    while(!TouchLED10.pressing() && !confirmPillNumber)\n    {\n      if (timer1.time(seconds) > 5)\n      {\n        confirmPillNumber = true;\n      }\n    }\n    while(TouchLED10.pressing())\n    {}\n    if(!confirmPillNumber)\n    {\n      numberOfPillsRequested++;\n    }\n  }\n\n}\n\nvoid pillInventory (int &numberOfPills, int pillsAddedOrRemoved)\n{\n  int currentNumPills = numberOfPills;\n  numberOfPills = currentNumPills + pillsAddedOrRemoved;\n}\n\nstd::string colourDetect(int &greenPill, int &bluePill, int &redPill)\n{\n  Brain.Screen.setCursor(3,1);\n  std::string sensedColour =\"\";\n  Optical2.setLight(ledState::on);\n  \n  color detected = hueToColor(Optical2.hue());\n  if(detected == green)\n  {\n    sensedColour = \"green\";\n    greenPill++;\n    Brain.Screen.print(\"green\");\n  }\n  else if(detected == blue)\n  {\n    sensedColour=\"blue\";\n    bluePill ++;\n    Brain.Screen.print(\"blue\");\n  }\n  else if(detected == red)\n  {\n    sensedColour=\"red\";\n    redPill ++;\n    Brain.Screen.print(\"red\");\n  }\n  return sensedColour;\n\n}\n\nvoid resetMotors(motor &targetMotor)\n{\n\tint curAngl = (targetMotor.position(degrees) * -1) - 5;\n\ttargetMotor.resetPosition();\n\t\n\ttargetMotor.spin(reverse, 50, percent);\n\twhile(targetMotor.position(degrees) > curAngl) \n\t{\n\t\twait(10, msec);\n\t}\n\ttargetMotor.stop();\n}\n\n\n","textLanguage":"cpp","robotConfig":[{"port":[1],"name":"Motor1","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[9],"name":"Motor9","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"},"triportSourcePort":22},{"port":[3],"name":"Motor3","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse"}},{"port":[7],"name":"Motor7","customName":false,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"true","fwd":"forward","rev":"reverse"}},{"port":[2],"name":"Optical2","customName":false,"deviceType":"Optical","deviceClass":"optical","setting":{}},{"port":[],"name":"Controller","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","e":"","eDir":"false","f":"","fDir":"false","l3r3":"","l3r3Dir":"false","drive":"none"}},{"port":[10],"name":"TouchLED10","customName":false,"deviceType":"TouchLED","deviceClass":"touchled","setting":{}}],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}